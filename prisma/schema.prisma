// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ==========================================
// USER & AUTHENTICATION
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  avatar        String?
  role          Role      @default(USER)
  plan          Plan      @default(STARTER)
  credits       Int       @default(5)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  prompts       Prompt[]
  generations   Generation[]
  favorites     Favorite[]
  flaggedContent FlaggedContent[]
  sessions      Session[]
  notifications Notification[]

  @@index([email])
  @@index([status])
  @@index([plan])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ==========================================
// PROMPTS & CATEGORIES
// ==========================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  prompts     Prompt[]
  templates   PromptTemplate[]

  @@index([slug])
  @@index([isActive])
}

model Prompt {
  id            String      @id @default(cuid())
  title         String
  content       String
  description   String?
  type          PromptType  @default(IMAGE)
  isPublic      Boolean     @default(false)
  isFeatured    Boolean     @default(false)
  usageCount    Int         @default(0)
  rating        Float       @default(0)
  ratingCount   Int         @default(0)
  likes         Int         @default(0)
  tags          String?     // JSON array stored as string
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Foreign Keys
  userId        String
  categoryId    String

  // Relations
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id])
  generations   Generation[]
  favorites     Favorite[]

  @@index([userId])
  @@index([categoryId])
  @@index([isPublic])
  @@index([isFeatured])
  @@index([type])
}

model PromptTemplate {
  id          String     @id @default(cuid())
  title       String
  content     String
  description String?
  type        PromptType @default(IMAGE)
  variables   String?    // JSON array of variables
  preview     String?    // Preview image URL
  isActive    Boolean    @default(true)
  order       Int        @default(0)
  usageCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Foreign Keys
  categoryId  String

  // Relations
  category    Category   @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isActive])
  @@index([type])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  promptId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([userId])
  @@index([promptId])
}

// ==========================================
// AI MODELS & GENERATION
// ==========================================

model AIModel {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  type          PromptType @default(IMAGE)
  creditCost    Int      @default(2)
  maxResolution String?
  features      String?  // JSON array
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  generations   Generation[]

  @@index([slug])
  @@index([isActive])
  @@index([type])
}

model Generation {
  id              String           @id @default(cuid())
  type            PromptType       @default(IMAGE)
  promptText      String
  enhancedPrompt  String?
  negativePrompt  String?
  status          GenerationStatus @default(PENDING)
  creditsUsed     Int              @default(0)
  processingTime  Int?             // in milliseconds

  // Generation Settings
  width           Int?
  height          Int?
  aspectRatio     String?
  quality         String?          @default("standard")
  seed            Int?
  steps           Int?
  guidance        Float?

  // Output
  outputUrl       String?
  thumbnailUrl    String?
  error           String?

  // Timestamps
  createdAt       DateTime         @default(now())
  completedAt     DateTime?

  // Foreign Keys
  userId          String
  modelId         String
  promptId        String?

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  model           AIModel          @relation(fields: [modelId], references: [id])
  savedPrompt     Prompt?          @relation(fields: [promptId], references: [id])
  flaggedContent  FlaggedContent[]

  @@index([userId])
  @@index([modelId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// MODERATION & FLAGGED CONTENT
// ==========================================

model FlaggedContent {
  id           String           @id @default(cuid())
  type         PromptType       @default(IMAGE)
  reason       String
  confidence   Float            @default(0)
  status       ModerationStatus @default(PENDING)
  reportCount  Int              @default(1)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Foreign Keys
  userId       String
  generationId String

  // Relations
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation   Generation       @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([generationId])
  @@index([status])
}

// ==========================================
// PLATFORM SETTINGS & CONFIGURATION
// ==========================================

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, number, boolean, json
  group     String   @default("general")
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

model PricingTier {
  id          String   @id @default(cuid())
  plan        Plan     @unique
  name        String
  description String?
  credits     Int
  price       Float
  features    String?  // JSON array
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([plan])
  @@index([isActive])
}

model CreditTransaction {
  id          String          @id @default(cuid())
  userId      String
  amount      Int
  type        TransactionType
  description String?
  balanceAfter Int
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Plan {
  FREE
  STARTER
  GROWTH
  PROFESSIONAL
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  BANNED
}

enum PromptType {
  IMAGE
  VIDEO
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum TransactionType {
  PURCHASE
  USAGE
  REFUND
  BONUS
  REFERRAL
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}
